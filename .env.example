# Warehouse connection (docker-compose exposes Postgres on 5433)
DATABASE_URL=postgresql://oil:oil@localhost:5433/oil

# dbt reads these (see transform/profiles.yml)
DBT_HOST=localhost
DBT_PORT=5433
DBT_USER=oil
DBT_PASSWORD=oil
DBT_DBNAME=oil

# Where raw API payloads are archived (bronze / landing zone)
LANDING_DIR=data/landing
